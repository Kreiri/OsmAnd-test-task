<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/summary_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.example.osmandtesttask.ui.common.components.StorageInfoView
            android:background="?attr/colorSurface"
            android:id="@+id/storage_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelText="@string/storage_label_internal"
            tools:spaceText="13 GB"
            tools:barColor="#ff0000"
            />
    </FrameLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/child_fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/summary_view"
        tools:layout="@layout/fragment_maps_list" />
</androidx.constraintlayout.widget.ConstraintLayout>